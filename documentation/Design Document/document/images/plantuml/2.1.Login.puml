@startuml
title Login Sequence Diagram

actor User

participant LoginPage as "<color:white>LoginPage</color>" #darkgreen
participant UserPage as "<color:white>UserPage</color>" #darkgreen
participant UserController as "<color:white>UserController</color>" #151b8e
participant AuthService as "<color:white>AuthService</color>" #000000
participant GoogleAuthInterface
participant GoogleAuth
collections FirebaseAuth
database FirebaseFirestore


User -> LoginPage : Press login button

alt Email and password login
    LoginPage -> LoginPage : _loginEmailPwd(context)

    alt Empty email or password
        LoginPage --> User : Show SnackBar(fill_fields_label)
    else Valid fields
        LoginPage -> UserController : login(email, password)
        UserController -> AuthService : login(email, password)

        AuthService -> FirebaseAuth : signInWithEmailAndPassword(email, password)
        FirebaseAuth --> AuthService : UserCredential

        note right of AuthService
         loadUserCore(cred.user!.uid)
        end note
        AuthService -> FirebaseFirestore : _db.collection("users").doc(uid).get()
        FirebaseFirestore --> AuthService : snap

        AuthService -> AuthService : _currentUser = new User instance with snap data

        AuthService --> UserController : completed
        UserController -> UserController : _currentUser = _authService.currentUser
        UserController --> LoginPage : completed

        'LoginPage -> DiaryController : currentUser = userController.currentUser
        LoginPage -> UserPage : Navigator.pushReplacement(UserPage)
        ref over UserPage, UserController : Load User Profile
        UserPage --> User : Show user page
    end
    

else Google login
    LoginPage -> LoginPage : _loginGoogle(context)
    LoginPage -> UserController : loginWithGoogle()
    UserController -> AuthService : loginWithGoogle()

    AuthService -> GoogleAuth : signOut()
    GoogleAuth --> AuthService : completed

    AuthService -> GoogleAuth : signIn()
    GoogleAuth --> GoogleAuthInterface : googleUsers available for login

note right of User
 continues 
end note

@enduml