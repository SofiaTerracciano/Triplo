% Bracket
\DeclarePairedDelimiterX{\rndb}[1]{(}{)}{\pargs{#1}}
\DeclarePairedDelimiterX{\sqrb}[1]{[}{]}{\pargs{#1}}
\DeclarePairedDelimiterX{\crlb}[1]{\{}{\}}{\pargs{#1}}
\DeclarePairedDelimiterX{\modb}[1]{|}{|}{\pargs{#1}}
\DeclarePairedDelimiterX{\normb}[1]{\lVert}{\rVert}{\pargs{#1}}
\DeclarePairedDelimiterX{\angleb}[1]{\langle}{\rangle}{\pargs{#1}}

\NewDocumentCommand{\rb}{ % Parentesi Tonde
    o 
    m
}{ 
    \IfNoValueTF{#1}{
        \rndb*{#2}
    }{
        \IfEqCase{#1}{
            {big}{\bigl(\pargs{#2}\bigr)}
            {Big}{\Bigl(\pargs{#2}\Bigr)}
            {bigg}{\biggl(\pargs{#2}\biggr)}
            {Bigg}{\Biggl(\pargs{#2}\Biggr)}
        }[\rndb*{#2}]
    }
}

\NewDocumentCommand{\sq}{ % Parentesi Quadre
    o 
    m
}{ 
    \IfNoValueTF{#1}{
        \sqrb*{#2}
    }{
        \IfEqCase{#1}{
            {big}{\bigl[\pargs{#2}\bigr]}
            {bigg}{\biggl[\pargs{#2}\biggr]}
            {Big}{\Bigl[\pargs{#2}\Bigr]}
            {Bigg}{\Biggl[\pargs{#2}\Biggr]}
        }[\sqrb*{#2}]
    }
}

\NewDocumentCommand{\cb}{ % Parentesi Graffe
    o 
    m
}{ 
    \IfNoValueTF{#1}{
        \crlb*{#2}
    }{
        \IfEqCase{#1}{
            {big}{\bigl\{\pargs{#2}\bigr\}}
            {bigg}{\biggl\{\pargs{#2}\biggr\}}
            {Big}{\Bigl\{\pargs{#2}\Bigr\}}
            {Bigg}{\Biggl\{\pargs{#2}\Biggr\}}
        }[\crlb*{#2}]
    }
}

\NewDocumentCommand{\mb}{ % Modulo
    o 
    m
}{ 
    \IfNoValueTF{#1}{
        \modb*{#2}
    }{
        \IfEqCase{#1}{
            {big}{\bigl|\pargs{#2}\bigr|}
            {bigg}{\biggl|\pargs{#2}\biggr|}
            {Big}{\Bigl|\pargs{#2}\Bigr|}
            {Bigg}{\Biggl|\pargs{#2}\Biggr|}
        }[\modb*{#2}]
    }
}

\NewDocumentCommand{\norm}{ % Norma
    o 
    m
}{ 
    \IfNoValueTF{#1}{
        \normb*{#2}
    }{
        \IfEqCase{#1}{
            {big}{\bigl\|\pargs{#2}\bigr\|}
            {bigg}{\biggl\|\pargs{#2}\biggr\|}
            {Big}{\Bigl\|\pargs{#2}\Bigr\|}
            {Bigg}{\Biggl\|\pargs{#2}\Biggr\|}
        }[\normb*{#2}]
    }
}

\NewDocumentCommand{\angb}{ % Angle brackets
    o 
    m
}{ 
    \IfNoValueTF{#1}{
        \angleb*{#2}
    }{
        \IfEqCase{#1}{
            {big}{\bigl\langle\pargs{#2}\bigr\rangle}
            {bigg}{\biggl\langle\pargs{#2}\biggr\rangle}
            {Big}{\Bigl\langle\pargs{#2}\Bigr\rangle}
            {Bigg}{\Biggl\langle\pargs{#2}\Biggr\rangle}
        }[\angleb*{#2}]
    }
}

