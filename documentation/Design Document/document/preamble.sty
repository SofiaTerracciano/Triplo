% Enviroment to prevent text from going in new page
\newenvironment{stpar}[1][t]
{\noindent\begin{minipage}[#1]{\linewidth}}
{\end{minipage}\bigskip}

% Enviroment to prevent text from going in new page and split the page in 2 columns
\NewDocumentEnvironment{mcstpar}{
    O{h!} % #1 alignment of the first minipage
    m     % #2 first column width
    s     % #3 if present a vertical line is added between the two columns
    O{h!} % #4 alignment of the second minipage
    m     % #5 second column width
    +m    % #6 multiline argument corresponding to the first column content
    +m    % #7 multiline argument corresponding to the second column content
}{%
  \begin{minipage}[#1]{#2\linewidth}%
    #6%
  \end{minipage}\hfill\IfBooleanTF{#3}{\vline\hfill}{}%
  \begin{minipage}[#4]{#5\linewidth}%
    #7%
  \end{minipage}%
}{}

% Enviroment to prevent text from going in new page and split the page in 2 columns no hfill is added between the two columns
\NewDocumentEnvironment{mcstpar*}{
    O{h!} % #1 alignment of the first minipage
    m     % #2 first column width
    s     % #3 if present a vertical line is added between the two columns
    O{h!} % #4 alignment of the second minipage
    m     % #5 second column width
    +m    % #6 multiline argument corresponding to the first column content
    +m    % #7 multiline argument corresponding to the second column content
}{%
  \begin{minipage}[#1]{#2\linewidth}%
    #6%
  \end{minipage}\IfBooleanTF{#3}{\vline}{}%
  \begin{minipage}[#4]{#5\linewidth}%
    #7%
  \end{minipage}%
}{}

