% --- NEW FOOTNOTE --- %
\renewcommand{\thefootnote}{\roman{footnote}}
\newcounter{fnm} % default footnote mark counter

\NewDocumentCommand{\deccounter}{
    O{-1}   % #1 - value to subtract at the counter
    m       % #2 - the counter name
}{\addtocounter{#2}{#1}}

\NewDocumentCommand{\footnoteMark}{
    s       % #1 - if present doesn't add value to the counter
    O{1}    % #2 - value to add at the counter
    m       % #3 - the counter
}{\IfBooleanTF{#1}{}{\addtocounter{#3}{#2}}\footnotemark[\value{#3}]}

\NewDocumentCommand{\footnoteText}{
    s       % if present add to the counter a value 
    O{-1}   % the value to add at the counter
    m       % the counter
    m       % the footnote text
}{\IfBooleanTF{#1}{\addtocounter{#3}{#2}}{}\footnotetext[\value{#3}]{#4}}

\NewDocumentCommand{\fnMark}{ % refers to the default counter fnm
    s % if present doesn't add value to the counter
    O{1} % value to add at the counter
}{\IfBooleanTF{#1}{\footnoteMark*[#2]{fnm}}{\footnoteMark[#2]{fnm}}}

\NewDocumentCommand{\fnText}{
    s % if present add to the counter a value 
    O{-1} % the value to add at the counter
    m % the footnote text
}{\IfBooleanTF{#1}{\footnoteText*[#2]{fnm}{#3}}{\footnoteText{fnm}{#3}}}

