@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 12

hide empty members

class "Service_i"  << (I,#aaaaaa) >> <<interface>> {
  - userLocation()
  - weather(lat, lon, langCode)
  - forecast(lat, lon, langCode)
  - parseForecast(rawForecast)
  - weatherbitAlerts(lat, lon)
  - mockAlerts()
  - weatherIconUrl(icon)
  - resolveLayer(layer)
  - loadNavigationLocation()
  - navigationPositionStream()
  - openGpsSettings()
  - openPermissionSettings()
  - openTopoMapTile()
  - openTopoMapSubdomains()
  - hasInternet()
}

class "Trekking_i" as TrekkingI << (I,#aaaaaa) >> <<interface>> {
  - allTrekkings
  - isWeatherAlertEnabled(trekkingId)
  - searchTrekking(query)
  - getTrekkingId(trekkingName)
  - getWeatherAlertTrekkings()
  - disableWeatherAlertForTrekking(trekkingId)
  - getCachedImage(path)
  - getTrekkingById(trekkingId)
  - getTrekkingByIdAsync(trekkingId)
  - checkArrival(trekkingId, distanceInMeters, currentPos, local)
  - addTrekkingToSaved(trekkingId)
  - removeTrekkingFromSaved(trekkingId)
  - getCachedImages(challengeIds)
  - isTrekkingSaved(trekkingId)
  - getSavedTrekkings(userId)
}

class "User_i" as UserI << (I,#aaaaaa) >> <<interface>> {
  - login(email, password)
  - loginWithGoogle()
  - register(email, password)
  - sendPasswordReset(email)
  - requestPasswordReset()
  - logout()
  - searchUsers(query)
  - getUserById(userId)
  - getFollowers(userId)
  - getFollowing(userId)
  - updateUsername()
  - updateName()
  - updateSurname()
  - updateBirthdate(date)
  - updateProfilePhoto(file)
  - changeEmail(newEmail, currentPassword)
  - extractWatchPair(raw)
  - approveWatchPair(watchId, token)
  - getConnectedWatches()
  - enableRemoteLogoutForWatch(watchId)
  - clearRemoteLogoutForWatch(watchId)
  - currentUser
  - isGoogleUser
  - isPasswordUser
  - isLoading
}

class "Language_i" as LanguageI << (I,#aaaaaa) >> <<interface>> {
  - locale
  - setLocale(locale)
}

class "Diary_i" as DiaryI << (I,#aaaaaa) >> <<interface>> {
  - getRandomPublicDiariesFromFollowing(followingIds, limit)
  - getDownloadUrlChild(path)
  - loadPublicDiary(userId)
  - loadPrivateDiary(userId)
  - getPublicDiaries(userId)
  - fetchDiaryById(diaryId)
}

class "Challenge_i" as ChallengeI << (I,#aaaaaa) >> <<interface>> {
  - loadChallenges()
  - allChallenges
  - getCachedImage(path)
}

class "Permission_i" as PermissionI << (I,#aaaaaa) >> <<interface>> {
  - askPermissionOnce()
  - locationStatus()
  - isLocationGranted()
  - isLocationDenied()
  - openAppSettingsPage()
}

class "Notification_i" as NotificationI << (I,#aaaaaa) >> <<interface>> {
  - showTrekkingNotification(id, title, body, payload, channelId, channelName)
  - showWeatherNotification(id, title, body, payload)
  - notificationcontent(payload, local)
}

class "Memory_i" as MemoryI << (I,#aaaaaa) >> <<interface>> {
  - getImageFromDisk(url)
  - cacheImageOnDisk(url) 
  - getImageFromMemory(key)
  - saveImageToMemory(key, file)
  - removeImageFromMemory(key)
  - clearMemoryCache()
  - getSavedLocaleCode()
  - saveLocaleCode(localeCode)
  - learSavedLocaleCode()
  - getShownWeatherAlertKeys() 
  - saveShownWeatherAlertKeys(keys)
  - addShownWeatherAlertKey(key)
  - hasShownWeatherAlertKey(key)
  - removeShownWeatherAlertKey(key)
  - clearShownWeatherAlertKeys() 
}

class "geo_i" as geoI << (I,#aaaaaa) >> <<interface>> {
  - isLocationServiceEnabled()
  - getPositionStream() 
  - openLocationSettingsPage()
}

class "qi" as qI << (I,#aaaaaa) >> <<interface>> {
  - toMap()
  - fromMap(map, docId)
}

class "dmi" as dmI << (I,#aaaaaa) >> <<interface>> {
  - toMap()
  - fromMap(map, diaryId)
}

class "expi" as expI << (I,#aaaaaa) >> <<interface>> {
  - toMap()
  - fromMap(map, docId)
}

class "umi" as umI << (I,#aaaaaa) >> <<interface>> {
  - toMap()
  - fromMap(map, uId)
}

class "authservice_i" as authserviceI << (I,#aaaaaa) >> <<interface>> {
  - register(email, password)
  - login(email, password) 
  - loginWithGoogle() 
  - logout()
  - endPasswordReset(email)
  - requestPasswordReset()
  - loadUserCore(uid)
  - tryAutoLogin()
  - approveWatchPair(watchId, token)
  - changeEmail(newEmail, currentPasssword)
  - refreshEmailFromAuth() 
  - getConnectedWatches()
  - enableRemoteLogoutForWatch(watchId)
  - clearRemoteLogoutForWatch(watchId)
}


@enduml